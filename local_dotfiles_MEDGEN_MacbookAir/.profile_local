# Remote tmux (`mouse on`) puts this terminal into mouse-reporting mode. When an
# ssh session dies uncleanly (lid closed, VPN drop) tmux never sends the disable
# sequences, so clicks/scrolls emit garbage until `reset`. fixterm undoes just
# those modes; run it after every ssh so it heals itself.
fixterm() {
    [ -t 1 ] || return 0   # guard: don't corrupt `ssh host cmd | grep ...`
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l\033[?1004l\033[?25h'
    stty sane 2>/dev/null
}
ssh() { command ssh "$@"; _ft=$?; fixterm; return $_ft; }
