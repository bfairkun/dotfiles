Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host midway* beagle3*
	User bjf79
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	RemoteForward 2224 127.0.0.1:2224
	ForwardX11Trusted yes
	ForwardX11 yes
	# 127.0.0.1, not localhost: the remote-side name resolves to ::1 first, and
	# another user's IPv6-only listener on 8765 hijacks the forward (see below).
	# Midway's plot server uses 8775-8779, NOT 8765-8769: the greatlakes block
	# forwards 8765-8768, and whichever connection opens first owns those laptop
	# ports (the second one's forwards silently fail to bind).
	LocalForward 8775 127.0.0.1:8775
	LocalForward 8776 127.0.0.1:8776
	LocalForward 8777 127.0.0.1:8777
	LocalForward 8778 127.0.0.1:8778
	LocalForward 8779 127.0.0.1:8779
	ControlMaster auto
	ControlPath ~/.ssh/control-%r@%h:%p
	ControlPersist 24h
	ServerAliveInterval 60
	ServerAliveCountMax 5

Host greatlakes
	HostName gl-login3.arc-ts.umich.edu
	User benfair
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	RemoteForward 2224 127.0.0.1:2224
	LocalForward 8765 127.0.0.1:8765
	LocalForward 8766 127.0.0.1:8766
	LocalForward 8767 127.0.0.1:8767
	LocalForward 8768 127.0.0.1:8768
	ControlMaster auto
	ControlPath ~/.ssh/control-%r@%h:%p
	ControlPersist 24h
	ServerAliveInterval 60
	ServerAliveCountMax 5

# Agent entry point to Great Lakes (e.g. Claude Science): a lightweight compute-node job
# named cs-node, reached through the live `greatlakes` ControlMaster (you open it with
# `ssh -fN greatlakes`; that Okta step is the only manual one). ~/bin/cs-node-ensure on
# the login node submits cs-node on demand and prints its node; the job exits itself after
# 30 idle min. Compute nodes accept publickey, so no Okta. Key is limited in GL
# authorized_keys by from="141.211.192.40" (gl-login3), so it only works through the master.
# BatchMode + ControlMaster=no on the inner hops: never starts a fresh Okta login.
# -n on the first hop: otherwise it reads the outer ssh handshake off stdin.
Host greatlakes-node
	User benfair
	IdentityFile ~/.ssh/id_ed25519_gl_app
	IdentitiesOnly yes
	PreferredAuthentications publickey
	BatchMode yes
	ControlMaster no
	ControlPath none
	ClearAllForwardings yes
	HostKeyAlias greatlakes-node
	StrictHostKeyChecking accept-new
	ProxyCommand sh -c 'n=$(ssh -n -o BatchMode=yes -o ControlMaster=no greatlakes "~/bin/cs-node-ensure" 2>/dev/null | tail -1); case "$n" in gl[0-9]*) ;; *) echo "greatlakes-node: ${n:-no live greatlakes master (run: ssh -fN greatlakes)}" >&2; exit 1;; esac; exec ssh -o BatchMode=yes -o ControlMaster=no -W "$n:22" greatlakes'

# beagle3 shares Midway3's /home and Slurm; login1-4 exist and
# beagle3.rcc.uchicago.edu round-robins login3/4. Pin one node so you always
# reattach to the same tmux server (tmux is per-node).
Host beagle3
	HostName beagle3-login4.rcc.uchicago.edu

Host midway
