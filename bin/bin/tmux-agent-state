#!/usr/bin/env bash
# tmux-agent-state -- flag the tmux window of an AI agent that wants your attention.
#
# Claude and Codex hooks store @agent_state per pane. The window displays separate
# red attention and green finished counts. Selecting a pane clears only its done
# marker; answering/resuming clears attention. prefix+a visits a flagged pane.
# Usage: attn | done | clear | clear-done [pane-id] | aggregate [window-id] | jump
# Hook failures are quiet and never interrupt an agent.

set -u

tm() { tmux "$@" 2>/dev/null; }

# Panes whose current command is one of these still count as a live agent; anything else
# in a window flagged 'attn' means the agent died (Ctrl-C, node reboot) and the flag is
# stale.
AGENT_CMDS="claude codex node"

# --- helpers ----------------------------------------------------------------

# Recompute a window's aggregate state from its panes. attn beats done beats nothing.
aggregate() {
    local target=$1 st agg="" attn=0 done=0
    while IFS= read -r st; do
        case $st in
            attn) attn=$((attn + 1)) ;;
            done) done=$((done + 1)) ;;
        esac
    done < <(tm list-panes -t "$target" -F '#{@agent_state}')
    [ "$done" -gt 0 ] && agg=done
    [ "$attn" -gt 0 ] && agg=attn
    tm set-option -w -t "$target" @agent_attn_count "$attn"
    tm set-option -w -t "$target" @agent_done_count "$done"
    if [ -n "$agg" ]; then
        tm set-option -w -t "$target" @agent_win_state "$agg"
    else
        tm set-option -uw -t "$target" @agent_win_state
    fi
}

# Set this pane's state ('' clears). Returns 1 if already at that value, which is the
# fast path that keeps the per-tool-call 'clear' down to a single tmux invocation.
set_state() {
    local new=$1 cur
    cur=$(tm show-options -pqv -t "$PANE" @agent_state)
    [ "$cur" = "$new" ] && return 1
    if [ -n "$new" ]; then
        tm set-option -p -t "$PANE" @agent_state "$new"
    else
        tm set-option -up -t "$PANE" @agent_state
    fi
    return 0
}

# True when you are already looking at this selected pane, so there is nothing to alert.
watched() {
    local r
    r=$(tm display-message -p -t "$PANE" '#{pane_active}:#{window_active}:#{session_attached}')
    case $r in 1:1:0|1:1:) return 1 ;; 1:1:*) return 0 ;; *) return 1 ;; esac
}

# Write BEL to the pane's own tty. Going through #{pane_tty} rather than /dev/tty is what
# makes this work from a background pane: tmux reads it as pane output, so monitor-bell
# (on by default) flags the window and the outer terminal can raise a desktop
# notification. tmux 3.2 has no allow-passthrough, so OSC-9 is not an option here.
bell() {
    local tty
    tty=$(tm display-message -p -t "$PANE" '#{pane_tty}')
    [ -n "$tty" ] && [ -w "$tty" ] && printf '\a' > "$tty"
}

# status-interval is 15s; without this the marker would lag by up to that long.
refresh() { tm refresh-client -S; }

need_pane() {
    PANE=${TMUX_PANE:-}
    [ -n "$PANE" ] || exit 0
}

# --- subcommands ------------------------------------------------------------

case ${1:-} in

attn)
    need_pane
    payload=""
    [ -t 0 ] || payload=$(cat)
    ntype=$(printf '%s' "$payload" |
        sed -n 's/.*"notification_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    case $ntype in
        # Only events where the agent is BLOCKED and cannot proceed without you.
        permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input) ;;
        # Deliberately NOT idle_prompt: it fires ~60s after any turn ends, so with several
        # sessions open it reddens nearly every tab, and because it lands after Stop it
        # would flip a green tick to a red dot that then survives being visited. "Finished
        # and unread" is already the job of 'done'. (Note it fires regardless of the
        # inputNeededNotifEnabled setting -- that gates Claude's own notification, not the
        # hook.) Also not auth_success / quota_* / elicitation_complete.
        "") ;;   # no payload: direct CLI invocation, for testing
        *) exit 0 ;;
    esac
    # Bell unconditionally (minus suppression) so a second prompt still alerts even when
    # the window is already flagged.
    watched || bell
    if set_state attn; then
        aggregate "$PANE"
        refresh
    fi
    ;;

done)
    need_pane
    # A turn you watched finish is not news.
    watched && exit 0
    if set_state done; then
        aggregate "$PANE"
        refresh
    fi
    ;;

clear)
    need_pane
    if set_state ""; then
        aggregate "$PANE"
        refresh
    fi
    ;;

clear-done)
    PANE=${2:-}
    [ -n "$PANE" ] || PANE=$(tm display-message -p '#{pane_id}')
    [ -n "$PANE" ] || exit 0
    if [ "$(tm show-options -pqv -t "$PANE" @agent_state)" = done ]; then
        set_state ""
    fi
    # Reap flags from exited agents and reconcile killed panes without clearing
    # unread completions in the other live panes.
    while IFS='|' read -r pid st pcmd; do
        [ -n "$st" ] || continue
        case " $AGENT_CMDS " in
            *" $pcmd "*) ;;
            *) tm set-option -up -t "$pid" @agent_state ;;
        esac
    done < <(tm list-panes -t "$PANE" -F '#{pane_id}|#{@agent_state}|#{pane_current_command}')
    aggregate "$PANE"
    refresh
    ;;

aggregate)
    aggregate "${2:-${TMUX_PANE:-}}"
    refresh
    ;;

jump)
    cur=$(tm display-message -p '#{pane_id}')
    [ -n "$cur" ] || exit 0
    # Search panes after the selected pane, then wrap. Red wins over green.
    ordered=$(tm list-panes -s -F '#{pane_id}|#{@agent_state}|#{window_id}' |
        awk -F'|' -v cur="$cur" '
            { if (seen) a[++n]=$0; else b[++m]=$0; if ($1 == cur) seen=1 }
            END { for (i=1;i<=n;i++) print a[i]; for (i=1;i<=m;i++) print b[i] }')
    for want in attn done; do
        t=$(printf '%s\n' "$ordered" | awk -F'|' -v w="$want" '$2 == w { print $1; exit }')
        if [ -n "$t" ]; then
            tm select-window -t "$t"
            tm select-pane -t "$t"
            "$0" clear-done "$t"
            exit 0
        fi
    done
    tm display-message "no agent pane needs attention"
    ;;

*)
    sed -n '2,20p' "$0" >&2
    exit 2
    ;;
esac

exit 0
