#!/usr/bin/env bash
# tmux-agent-state -- flag the tmux window of an AI agent that wants your attention.
#
# Driven by Claude Code hooks (agents/.claude{,-enterprise}/settings.json) and one tmux
# hook. State lives in tmux user options: @agent_state per pane, @agent_win_state
# aggregated per window. tmux/.tmux.conf renders the aggregate in the window status:
#   attn -> red  * before the name   (agent is blocked on you)
#   done -> green v after the name   (turn finished in a window you were not watching)
#
# Usage:
#   tmux-agent-state attn                 # Notification hook (hook JSON on stdin)
#   tmux-agent-state done                 # Stop hook
#   tmux-agent-state clear                # UserPromptSubmit / PostToolUse / SessionEnd
#   tmux-agent-state clear-done [win-id]  # tmux session-window-changed hook
#   tmux-agent-state jump                 # prefix+a
#
# Never fails loudly: a hook that errors must not disrupt a session, so every tmux call
# is best-effort and every path exits 0.

set -u

tm() { tmux "$@" 2>/dev/null; }

# Panes whose current command is one of these still count as a live agent; anything else
# in a window flagged 'attn' means the agent died (Ctrl-C, node reboot) and the flag is
# stale.
AGENT_CMDS="claude codex node"

# --- helpers ----------------------------------------------------------------

# Recompute a window's aggregate state from its panes. attn beats done beats nothing.
aggregate() {
    local target=$1 st agg=""
    while IFS= read -r st; do
        case $st in
            attn) agg=attn; break ;;
            done) agg=done ;;
        esac
    done < <(tm list-panes -t "$target" -F '#{@agent_state}')
    if [ -n "$agg" ]; then
        tm set-option -w -t "$target" @agent_win_state "$agg"
    else
        tm set-option -uw -t "$target" @agent_win_state
    fi
}

# Set this pane's state ('' clears). Returns 1 if already at that value, which is the
# fast path that keeps the per-tool-call 'clear' down to a single tmux invocation.
set_state() {
    local new=$1 cur
    cur=$(tm show-options -pqv -t "$PANE" @agent_state)
    [ "$cur" = "$new" ] && return 1
    if [ -n "$new" ]; then
        tm set-option -p -t "$PANE" @agent_state "$new"
    else
        tm set-option -up -t "$PANE" @agent_state
    fi
    return 0
}

# True when you are already looking at this pane's window, so there is nothing to alert.
watched() {
    local r
    r=$(tm display-message -p -t "$PANE" '#{window_active}:#{session_attached}')
    case $r in 1:0|1:) return 1 ;; 1:*) return 0 ;; *) return 1 ;; esac
}

# Write BEL to the pane's own tty. Going through #{pane_tty} rather than /dev/tty is what
# makes this work from a background pane: tmux reads it as pane output, so monitor-bell
# (on by default) flags the window and the outer terminal can raise a desktop
# notification. tmux 3.2 has no allow-passthrough, so OSC-9 is not an option here.
bell() {
    local tty
    tty=$(tm display-message -p -t "$PANE" '#{pane_tty}')
    [ -n "$tty" ] && [ -w "$tty" ] && printf '\a' > "$tty"
}

# status-interval is 15s; without this the marker would lag by up to that long.
refresh() { tm refresh-client -S; }

need_pane() {
    PANE=${TMUX_PANE:-}
    [ -n "$PANE" ] || exit 0
}

# --- subcommands ------------------------------------------------------------

case ${1:-} in

attn)
    need_pane
    payload=""
    [ -t 0 ] || payload=$(cat)
    ntype=$(printf '%s' "$payload" |
        sed -n 's/.*"notification_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    case $ntype in
        # Only events where the agent is BLOCKED and cannot proceed without you.
        permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input) ;;
        # Deliberately NOT idle_prompt: it fires ~60s after any turn ends, so with several
        # sessions open it reddens nearly every tab, and because it lands after Stop it
        # would flip a green tick to a red dot that then survives being visited. "Finished
        # and unread" is already the job of 'done'. (Note it fires regardless of the
        # inputNeededNotifEnabled setting -- that gates Claude's own notification, not the
        # hook.) Also not auth_success / quota_* / elicitation_complete.
        "") ;;   # no payload: direct CLI invocation, for testing
        *) exit 0 ;;
    esac
    # Bell unconditionally (minus suppression) so a second prompt still alerts even when
    # the window is already flagged.
    watched || bell
    if set_state attn; then
        aggregate "$PANE"
        refresh
    fi
    ;;

done)
    need_pane
    # A turn you watched finish is not news.
    watched && exit 0
    if set_state done; then
        aggregate "$PANE"
        refresh
    fi
    ;;

clear)
    need_pane
    if set_state ""; then
        aggregate "$PANE"
        refresh
    fi
    ;;

clear-done)
    win=${2:-}
    [ -n "$win" ] || win=$(tm display-message -p '#{window_id}')
    [ -n "$win" ] || exit 0
    # Fast path: nothing flagged here, and this runs on every window switch.
    [ -n "$(tm show-options -wqv -t "$win" @agent_win_state)" ] || exit 0
    changed=0
    while IFS='|' read -r pid st pcmd; do
        case $st in
            done)
                tm set-option -up -t "$pid" @agent_state; changed=1 ;;
            attn)
                # Visiting the window does not clear 'attn' (an unanswered permission
                # prompt should keep flagging) -- but reap it if the agent is gone.
                case " $AGENT_CMDS " in
                    *" $pcmd "*) ;;
                    *) tm set-option -up -t "$pid" @agent_state; changed=1 ;;
                esac
                ;;
        esac
    done < <(tm list-panes -t "$win" -F '#{pane_id}|#{@agent_state}|#{pane_current_command}')
    # Recompute unconditionally, not just when a pane changed: this is also where a
    # window flag left behind by a killed pane gets reconciled away.
    aggregate "$win"
    [ "$changed" = 1 ] && refresh
    ;;

jump)
    cur=$(tm display-message -p '#{window_index}')
    [ -n "$cur" ] || exit 0
    # Rotate the window list so the search starts just after the current window.
    # Carry the window id: a bare index is an ambiguous tmux target (with
    # pane-base-index 1, '-t 1' can resolve to pane 1 of the current window).
    ordered=$(tm list-windows -F '#{window_index}|#{@agent_win_state}|#{window_id}' |
        awk -F'|' -v cur="$cur" '
            { if ($1+0 > cur+0) a[++n] = $0; else b[++m] = $0 }
            END { for (i=1;i<=n;i++) print a[i]; for (i=1;i<=m;i++) print b[i] }')
    for want in attn done; do
        t=$(printf '%s\n' "$ordered" | awk -F'|' -v w="$want" '$2 == w { print $3; exit }')
        if [ -n "$t" ]; then
            tm select-window -t "$t"
            exit 0
        fi
    done
    tm display-message "no agent window needs attention"
    ;;

*)
    sed -n '2,20p' "$0" >&2
    exit 2
    ;;
esac

exit 0
