# .profile_local for RCC Midway
# Added myself, don't know why the conda blocks managed by conda init aren't
# working right.

echo "Running  ${0}..."
# set -x

export TZ='America/Chicago'
# export PATH="/home/bjf79/miniconda3/bin:$PATH"

export PATH=$PATH:~/scripts
# export PATH=$PATH:~/software
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# Ensure TMPDIR is /tmp so ssh-agent sockets don't land in $HOME
export TMPDIR='/tmp'

# Source ssh settings or start ssh agent if not already running
# Useful for ssh keys for git for example
mkdir -p $HOME/.ssh
SSH_ENV="$HOME/.ssh/agent-environment"

function start_agent {
    echo "Initialising new SSH agent..."
    /usr/bin/ssh-agent | sed 's/^echo/#echo/' > "${SSH_ENV}"
    echo succeeded
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}" > /dev/null
    /usr/bin/ssh-add;
}

# Source SSH settings, if applicable

if [ -f "${SSH_ENV}" ]; then . "${SSH_ENV}" > /dev/null
    #ps ${SSH_AGENT_PID} doesn't work under cywgin
    ps -ef | grep ${SSH_AGENT_PID} | grep ssh-agent$ > /dev/null || {
        start_agent;
    }
else
    start_agent;
fi


# Midway2 specific stuff
hostname | grep -q 'midway2'
if [ $? -eq 0 ]; then
    module unload gsl
    module load mosh
    module load gsl/2.5
    # module load rstudio
    module load netcat #useful to copy to local clipboard
    module load vim/8.1
    module load tmux/3.1c
fi

# Midway3 specific stuff
hostname | grep -q 'midway3'
if [ $? -eq 0 ]; then
    module load mosh
    # module load rstudio
    module load tmux
fi


# Attach or tmux session
if [[ -z "$TMUX" && -n "$SSH_CONNECTION" && "$-" == *i* ]]; then
    tmux attach-session -t ssh_tmux || tmux new-session -s ssh_tmux
fi

# Claude dispatcher watchdog deliberately not registered (2026-08-12): its RC
# health check matched a status string Claude Code no longer emits, so it never
# fired — yet Remote Control worked fine anyway. The tmux deaths it looked like
# it was for were unplanned node reboots, which no user-level cron can prevent.
# Re-enable: */5 * * * * $HOME/bin/dispatcher_watchdog.sh

# Ensure the Codex remote-control watchdog cron job is registered, so the Codex
# iOS app always has a live session to attach to. Same self-healing rationale as
# above: crontab lives on node-local /var, so it is lost if a node is rebuilt.
# Registering on every login node is intended — the script keeps a sticky pin
# (~/.codex/remote-control-pin) so only one node actually runs the daemon, and
# the others stand by to take over if the pinned node's heartbeat goes stale.
# Offset to minutes 2,7,12,... so it never collides with the entry above.
if [ -f ~/.codex/codex_remote_control_watchdog.sh ]; then
    if ! crontab -l 2>/dev/null | grep -q "codex_remote_control_watchdog.sh"; then
        (crontab -l 2>/dev/null; echo "2-59/5 * * * * $HOME/.codex/codex_remote_control_watchdog.sh") | crontab -
    fi
fi
