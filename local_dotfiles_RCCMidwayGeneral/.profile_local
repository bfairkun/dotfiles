# .profile_local for RCC Midway
# Added myself, don't know why the conda blocks managed by conda init aren't
# working right.

echo "Running  ${0}..."
# set -x

export TZ='America/Chicago'
# export PATH="/home/bjf79/miniconda3/bin:$PATH"

export PATH=$PATH:~/scripts
# export PATH=$PATH:~/software
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# Ensure TMPDIR is /tmp so ssh-agent sockets don't land in $HOME
export TMPDIR='/tmp'

# Keep regenerable caches out of $HOME.  The home quota here is small, and once
# ~/.cache fills, every XDG-compliant tool starts failing with "Disk quota
# exceeded" -- e.g. `import arviz` raises OSError errno 122 because it writes a
# once-per-day stamp via platformdirs.user_cache_dir().  pip (which had grown a
# 6.7 GiB cache), matplotlib and fontconfig all resolve their cache dir the same
# way, so redirecting XDG_CACHE_HOME fixes all of them at once.  Scratch is the
# right home for this: caches are disposable, so a scratch purge is harmless.
case "$(hostname)" in
    *midway2*) _xdg_scratch="/scratch/midway2/$USER" ;;
    *midway3*) _xdg_scratch="/scratch/midway3/$USER" ;;
    *)         _xdg_scratch='' ;;
esac
if [ -n "$_xdg_scratch" ] && [ -d "$_xdg_scratch" ]; then
    export XDG_CACHE_HOME="$_xdg_scratch/.cache"
    mkdir -p "$XDG_CACHE_HOME"
fi
unset _xdg_scratch

# Source ssh settings or start ssh agent if not already running
# Useful for ssh keys for git for example
mkdir -p $HOME/.ssh
SSH_ENV="$HOME/.ssh/agent-environment"

# A long-lived tmux session pins the SSH_AUTH_SOCK it was created with. Each new login used
# to start an agent at a fresh random socket path, so an old pane kept pointing at a dead or
# EMPTY agent and git push failed with "Permission denied (publickey)" even though a loaded
# agent was running -- the key looks unloaded when it is merely the wrong agent. Fix: keep a
# stable symlink and export that, so every pane resolves to whichever agent is current.
SSH_SOCK_LINK="$HOME/.ssh/agent.sock"

function start_agent {
    echo "Initialising new SSH agent..."
    /usr/bin/ssh-agent | sed 's/^echo/#echo/' > "${SSH_ENV}"
    echo succeeded
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}" > /dev/null
    /usr/bin/ssh-add;
}

# Adopt any already-running agent that holds identities before starting another one, so
# repeated logins stop accumulating agents (there were 5, three loaded and two empty).
function adopt_live_agent {
    for _s in /tmp/ssh-*/agent.* "${SSH_SOCK_LINK}"; do
        [ -S "$_s" ] || continue
        if SSH_AUTH_SOCK="$_s" ssh-add -l >/dev/null 2>&1; then
            export SSH_AUTH_SOCK="$_s"
            return 0
        fi
    done
    return 1
}

if [ -f "${SSH_ENV}" ]; then . "${SSH_ENV}" > /dev/null
    #ps ${SSH_AGENT_PID} doesn't work under cywgin
    ps -ef | grep ${SSH_AGENT_PID} | grep ssh-agent$ > /dev/null || {
        start_agent;
    }
else
    start_agent;
fi

# If the agent we just sourced has no identities, prefer a live one that does; only then is a
# passphrase prompt actually warranted.
ssh-add -l >/dev/null 2>&1 || adopt_live_agent || true

# Republish under the stable path. Panes should use this, not the raw /tmp path.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ] \
   && [ "${SSH_AUTH_SOCK}" != "${SSH_SOCK_LINK}" ]; then
    ln -sfn "${SSH_AUTH_SOCK}" "${SSH_SOCK_LINK}"
    export SSH_AUTH_SOCK="${SSH_SOCK_LINK}"
fi


# Midway2 specific stuff
hostname | grep -q 'midway2'
if [ $? -eq 0 ]; then
    module unload gsl
    module load mosh
    module load gsl/2.5
    # module load rstudio
    module load netcat #useful to copy to local clipboard
    module load vim/8.1
    module load tmux/3.1c
fi

# Midway3 specific stuff
hostname | grep -q 'midway3'
if [ $? -eq 0 ]; then
    module load mosh
    # module load rstudio
    module load tmux
fi


# Start the phone bridge once per Midway3 login node, before attaching to tmux.
# A named tmux session also prevents duplicate starts from simultaneous logins.
if [[ "$-" == *i* && -z "${TMUX:-}" ]]; then
    case "$(hostname -s)" in
        midway3-login*)
            _bridge_dir=/project/yangili1/bjf79/repos_not_projects/tmux-agent-bridge
            if [ -x "$_bridge_dir/run.sh" ] && command -v tmux >/dev/null 2>&1; then
                if ! pgrep -u "$(id -u)" -f '/project/yangili1/bjf79/repos_not_projects/tmux-agent-bridge/bridge[.]py([[:space:]]|$)' >/dev/null 2>&1 &&
                   ! timeout 5 tmux has-session -t '=bridge' 2>/dev/null; then
                    timeout 5 tmux new-session -d -s bridge -c "$_bridge_dir" \
                        'umask 077; exec ./run.sh >>bridge.log 2>&1' 2>/dev/null || :
                fi
            fi
            unset _bridge_dir
            ;;
    esac
fi

# Attach or tmux session
if [[ -z "$TMUX" && -n "$SSH_CONNECTION" && "$-" == *i* ]]; then
    tmux attach-session -t ssh_tmux || tmux new-session -s ssh_tmux
fi

