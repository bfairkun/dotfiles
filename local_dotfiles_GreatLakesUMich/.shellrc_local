# .shellrc_local for UMich Great Lakes HPC
# Sourced by .bashrc_local and .zshrc_local — POSIX-compatible content only.

echo "Running  ${0}..." >&2

# Switch to zsh for interactive bash sessions (zsh has syntax highlighting via oh-my-zsh)
[[ $- == *i* && -z "$ZSH_VERSION" ]] && exec zsh  # non-login: bash already ran /etc/profile

function update_display {
    # Sync the DISPLAY variable from tmux's environment.
    # Call this before launching GUI apps (R, RStudio) from inside tmux,
    # otherwise X11 forwarding may point to a stale display.
    if [ ! -z $TMUX ]; then
        export DISPLAY="`tmux show-env | sed -n 's/^DISPLAY=//p'`"
    fi
}

# Load R module. Great Lakes offers R 4.2.0 through 4.6.0.
# Default (no module load) gives 4.4.3. Change version as desired.
module load R/4.4.3

# Note: mosh is NOT available on Great Lakes (unlike Midway2/3).
# Note: tmux comes from `module load tmux/3.3a` in .profile_local (system tmux 2.7 is too old).
# Note: node.js available if needed: check with `module spider node`

# Compact squeue output showing your jobs
alias sq='squeue --me --format="%.18i %.9P %.60j %.8u %.8T %.10M %.9l %.6D %R"'
# Watch your jobs refresh every 5 seconds
alias watchjobs='watch -n 5 "squeue --me --format=\"%.18i %.9P %.60j %.8u %.8T %.10M %.9l %.6D %R\""'
alias claude_dispatcher='tmux new-window -n "dispatcher" "claude --agent dispatcher -n dispatcher"'
alias R='update_display && R'
alias rstudio='update_display && rstudio'

# Load secret API keys (e.g., ANTHROPIC_API_KEY) — not tracked in dotfiles.
# Add your keys to ~/.secrets: export ANTHROPIC_API_KEY="sk-ant-..."
[ -f ~/.secrets ] && source ~/.secrets

# Auto-start agent plots HTTP server. Login nodes are shared: other users may
# hold 8765, so the server falls back up to 8769 and records the port it bound in
# ~/.agent_plots_port. Only skip startup if *our* uid owns that port on this node.
# Interactive shells only, so non-interactive ssh commands and Slurm job
# shells on compute nodes don't spawn one.
if [[ $- == *i* ]]; then
    mkdir -p ~/agent_plots
    _ap_port=$(cat ~/.agent_plots_port 2>/dev/null)
    if [ -z "$_ap_port" ] || ! ss -tlne 2>/dev/null | grep -Eq ":$_ap_port[[:space:]].*uid:$(id -u)[[:space:]]"; then
        nohup python3 ~/.agents/skills/agent-plots/agent_plots_server.py --port 8765 --directory ~/agent_plots > ~/agent_plots/server.log 2>&1 &
    fi
    unset _ap_port
fi

# List running Jupyter kernels (newest first).
# Useful to see what compute kernels are active for Claude Code agent connections.
function jk() {
    local seen=()
    local found=0
    while IFS= read -r line; do
        local cf
        cf=$(echo "$line" | grep -oE ' -+f[= ][^ ]+\.json' | grep -oE '[/~][^ ]+')
        [[ -n "$cf" && -f "$cf" ]] || continue
        local already=0
        for s in "${seen[@]}"; do [[ "$s" == "$cf" ]] && already=1 && break; done
        [[ $already -eq 1 ]] && continue
        seen+=("$cf")
        printf "  %s  %s\n" "$(date -r $cf '+%Y-%m-%d %H:%M:%S')" "$cf"
        found=1
    done < <(pgrep -u $UID -af 'ipykernel' 2>/dev/null)
    [[ $found -eq 0 ]] && echo "No running Jupyter kernels."
}
